# Pins and acceptance receipts refer to exact bytes. Disable platform EOL
# conversion; ordinary source diffs remain available through Git's detection.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve generated artifacts and their byte-level delivery provenance on Windows.
figures/*.archify.html -text
figures/*.archify.json -text
figures/*.archify.delivery.json -text
figures/ARCHIFY-LICENSE.txt -text
figures/ARCHIFY-THIRD-PARTY-NOTICES.txt -text
figures/JetBrainsMono-OFL.txt -text
browser-rag/notices/*.txt -text
# Keep the pinned upstream hash graph byte-identical across Windows checkouts.
browser-rag/vendor/noble-hashes/sha2.js -text
browser-rag/vendor/noble-hashes/_md.js -text
browser-rag/vendor/noble-hashes/_u64.js -text
browser-rag/vendor/noble-hashes/utils.js -text
browser-rag/vendor/noble-hashes/LICENSE -text
*.pdf binary
