@startuml
title Evidence before calculation — implemented vs proposed
skinparam backgroundColor #F7F8FA
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam defaultFontColor #172033
skinparam titleFontColor #172033
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #D8DFEB
skinparam noteFontColor #46536B
skinparam packageFontColor #172033
skinparam legendBackgroundColor #FFFFFF
skinparam legendFontColor #46536B
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #46536B
skinparam ArrowColor #46536B
rectangle "Original report\nPage / row / column / unit" as report
rectangle "Extract + chunk\nRelationships may be lost" as extraction
rectangle "Retrieve candidates\nRanking is not verification" as retrieval
rectangle "Review source\nPeriod / metric / value / unit" as review
rectangle "Accept explicit rows\nReview status + source locator" as accepted
rectangle "Lookup / calculate\nCheck units + denominator" as calculate
rectangle "Unresolved\nDo not accept" as hold #FFF4E5
report -right-> extraction
extraction -right-> retrieval
retrieval .down.> review : proposed
review .left.> accepted : accepted
accepted .left.> calculate : proposed
review .down.> hold : ambiguous
legend bottom
Solid: implemented document path
Dotted: proposed review-and-calculation path
No implemented SQL agent or verified calculation service is claimed.
endlegend
@enduml
